# Copy this file to .env and fill in values for your environment.
# .env is gitignored and never committed.

# Expo SDK 49+: EXPO_PUBLIC_ prefix exposes vars to the JS bundle at build time.

# For iOS Simulator / Android Emulator on the same machine:
EXPO_PUBLIC_API_URL=http://localhost:8000

# For a physical device on the same LAN (replace with your machine's local IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Android emulator needs 10.0.2.2 instead of localhost:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Production:
# EXPO_PUBLIC_API_URL=https://api.yourplatform.com
